<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Theme (optional) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Use custom switch style throughout if needed -->
        <item name="switchStyle">@style/CustomSwitch</item>
    </style>

    <!-- Custom Switch Style -->
    <style name="CustomSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/custom_switch_thumb</item>
        <item name="android:track">@drawable/custom_switch_track</item>
    </style>

    <style name="ToggleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_toggle_selector</item>
        <item name="android:button">@null</item> <!-- Removes default radio icon -->
        <item name="android:textColor">@color/text_toggle_selector</item>
        <item name="android:textAlignment">center</item>

        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/kanit</item>
    </style>

    <style name="BatteryFragToggleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/batfrag_toggle_selector</item>
        <item name="android:button">@null</item> <!-- Removes default radio icon -->
        <item name="android:textColor">@color/text_toggle_selector</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">20sp</item>
        <item name="android:radius">40sp</item>
        <item name="android:fontFamily">@font/kanit</item>
    </style>

    <style name="riderprofiletogglestyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:background">@drawable/ridefrag_toggle_selector</item>
        <item name="android:button">@null</item> <!-- Removes default radio icon -->
        <item name="android:textColor">@color/text_toggle_selector</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">20sp</item>
        <item name="android:radius">20sp</item>
        <item name="android:fontFamily">@font/kanit</item>
    </style>

    <style name="QuickButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">92dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/rounded_button1</item>
        <item name="android:backgroundTint">#444444</item>
        <item name="android:fontFamily">@font/kanit</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20dp</item>
    </style>

    <style name="DataButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">92dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/rounded_button1</item>
        <item name="android:backgroundTint">#444444</item>
        <item name="android:fontFamily">@font/kanit</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20dp</item>
    </style>
    <!-- Slide Animation Theme for Activity -->
    <style name="TransparentSlideTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/SlideAnimationStyle</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TransparentSlideThemeforOthers" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="textAllCaps">false</item>   <!-- Works with AppCompat -->
    </style>


    <!-- Actual Animation Definition -->
    <style name="SlideAnimationStyle">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_down</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_up</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_down</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_up</item>
    </style>

