<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#1B222A"/> <!-- blue when selected -->
            <corners android:radius="110dp"/> <!-- round corners -->
            <stroke android:width="2.5dp" android:color="#1E88E5"/>
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="110dp"/> <!-- keep round -->
            />
        </shape>
    </item>
</selector>
