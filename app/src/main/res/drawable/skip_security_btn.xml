<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#31629A"/>
            <corners android:radius="110dp"/>
            <stroke
                android:width="2dp"
                android:color="#1C78BE"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="110dp"/>
            <stroke
                android:width="2dp"
                android:color="#1C78BE"/>
        </shape>
    </item>

</selector>