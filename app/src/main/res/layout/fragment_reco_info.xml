            android:textColor="#6CFF9E"
            android:textSize="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/note"
            android:layout_width="550dp"
            android:layout_height="146dp"
            android:layout_marginStart="58dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/kanit"
            android:text="Every time you apply brakes, your scooter recovers energy and adds extra kilometers back to the battery — improving efficiency, extending range, and reducing energy loss.\n\nRide smarter. Ride efficient."
            android:textColor="#6A6A6A"
            android:textSize="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/powernote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="56dp"
