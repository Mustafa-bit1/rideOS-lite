<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="1001dp"
    android:layout_height="418dp"
    android:background="@drawable/fragmentbg">
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="22dp"
        android:paddingEnd="33dp"
        app:layout_constraintTop_toTopOf="@+id/scrollViewContent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <!-- Text Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanitlite"
                    android:paddingEnd="15dp"
                    android:text="Brightness"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/brightnessValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit"
                    android:paddingTop="10dp"
                    android:layout_marginTop="3dp"
                    android:text="brightnessValue"
                    android:textColor="#7D7D7D"
                    android:textSize="17sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/brightnessSlider"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:paddingEnd="15dp"
                android:max="255"
                android:progressDrawable="@drawable/custom_seekbar"
                android:splitTrack="false"
                android:thumb="@drawable/brigness_seekbarhtumb"
                android:thumbTint="@null" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:paddingVertical="8dp">

            <!-- Text Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Brightness"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/kanitlite"
                    android:textSize="32sp"
                    android:paddingEnd="15dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Adjust brightness automatically based on ambient light"
                    android:textColor="#7D7D7D"
                    android:paddingBottom="5dp"
                    android:fontFamily="@font/kanit"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Switch aligned right -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoBrightnessSwitch"
                android:layout_width="154dp"
                android:layout_height="58dp"
                android:layout_marginEnd="32dp"
                android:fontFamily="@font/kanitlite"
                android:gravity="center"
                android:scaleX="1.4"
                android:scaleY="1.4"
                android:text="Auto Brightness"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <!-- Text Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanitlite"
                    android:paddingEnd="15dp"
                    android:text="Theme"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit"
                    android:paddingTop="10dp"
                    android:text="Set rideOS theme"
                    android:textColor="#7D7D7D"
                    android:textSize="17sp" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/Theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/DarkTheme"
                    style="@style/ToggleStyle"
                    android:layout_width="120dp"
                    android:layout_height="78dp"
                    android:layout_marginEnd="22dp"
                    android:fontFamily="@font/kanit"
                    android:text="Dark"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/LightThem"
                    style="@style/ToggleStyle"
                    android:layout_width="120dp"
                    android:layout_height="78dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/kanit"
                    android:text="Light" />

                <RadioButton
                    android:id="@+id/AutoTheme"
                    style="@style/ToggleStyle"
                    android:layout_width="120dp"
                    android:layout_height="78dp"
                    android:fontFamily="@font/kanit"
                    android:text="Auto" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

