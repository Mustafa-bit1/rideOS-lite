<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="1001dp"
    android:layout_height="418dp"
    android:background="@drawable/fragmentbg">

    <SeekBar
        android:id="@+id/brightnessSlider"
        android:layout_width="450dp"
        android:layout_height="90dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="30dp"
        android:max="255"
        android:progressDrawable="@drawable/custom_seekbar"
        android:thumb="@drawable/brigness_seekbarhtumb"
        android:thumbTint="@null"
        android:splitTrack="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="384dp"
        android:layout_height="44dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/kanitlite"
        android:text="Brightness"
        android:textColor="@color/white"
        android:textSize="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

<!--    <TextView-->
<!--        android:id="@+id/brightnessfooter"-->
<!--        android:layout_width="384dp"-->
<!--        android:layout_height="44dp"-->
<!--        android:layout_marginStart="32dp"-->
<!--        android:layout_marginTop="82dp"-->
<!--        android:fontFamily="@font/kanit"-->
<!--        android:text="Adjust overall screen brightness :"-->
<!--        android:textColor="#6A6A6A"-->
<!--        android:textSize="18dp"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent" />-->

    <TextView
        android:id="@+id/brightnessValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="83dp"
        android:text="Adjust overall screen brightness"
        android:textColor="#6A6A6A"
        android:fontFamily="@font/kanit"
        android:textSize="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/autobrightness"
        android:layout_width="384dp"
        android:layout_height="44dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="170dp"
        android:fontFamily="@font/kanitlite"
        android:text="Auto Brightness"
        android:textColor="@color/white"
        android:textSize="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/autobrightnessfooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="223dp"
        android:text="Adjust brightness automatically based on ambient light"
        android:textColor="#6A6A6A"
        android:fontFamily="@font/kanit"
        android:textSize="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/autoBrightnessSwitch"
        android:layout_width="154dp"
        android:layout_height="58dp"
        android:layout_marginTop="183dp"
        android:layout_marginEnd="76dp"
        android:fontFamily="@font/kanitlite"
        android:gravity="center"
        android:scaleX="1.4"
        android:scaleY="1.4"
        android:text="Auto Brightness"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/themeTV"
        android:layout_width="384dp"
        android:layout_height="44dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="310dp"
        android:fontFamily="@font/kanitlite"
        android:text="Theme Mode"
        android:textColor="@color/white"
        android:textSize="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/themeMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="363dp"
        android:text="Choose your prefered theme mode"
        android:textColor="#6A6A6A"
        android:fontFamily="@font/kanit"
        android:textSize="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="360dp"
        android:layout_marginTop="314dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/thememodes" />


</androidx.constraintlayout.widget.ConstraintLayout>