<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fragmentbg"
    tools:context="com.fanconn.rideOS.menu.riderProfilesFragment">

    <!-- ===========================================================
                     FIRST SCREEN (VISIBLE INITIALLY)
         =========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/initialContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Add Rider Button -->
        <ImageButton
            android:id="@+id/btnRegister"
            android:layout_width="198dp"
            android:layout_height="240dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="30dp"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/addrider_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- Scroll of Riders -->
        <HorizontalScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="286dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:layout_marginTop="2dp"
            android:layout_marginStart="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnRegister"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/ridersContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="30dp"
        android:background="@android:color/transparent"
        android:scaleType="fitXY"
        android:src="@drawable/rideerprofilebackbtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="50dp"
        android:background="@android:color/transparent"
        android:scaleType="fitXY"
        android:src="@drawable/ridepronextbtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnsave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:scaleType="fitXY"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="50dp"
        android:src="@drawable/ridersavebtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===========================================================
                     SECOND SCREEN (SETTINGS TABS)
         =========================================================== -->
    <LinearLayout
        android:id="@+id/settingsParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="20dp"
        >

        <!-- ==================== TAB SWITCH RADIO GROUP ==================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/toggle_group_bg"
                android:padding="9dp"
                android:gravity="center">

                <RadioGroup
                    android:id="@+id/topToggleGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/basicbtn"
                        style="@style/riderprofiletogglestyle"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Info"
                        android:padding="8dp"
                        android:textSize="19dp"

                        android:textColor="#FFFFFF"
                        android:button="@null" />


                    <RadioButton
                        android:id="@+id/advancedbtn"
                        style="@style/riderprofiletogglestyle"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Parameters"
                        android:padding="8dp"
                        android:textSize="19dp"

                        android:textColor="#FFFFFF"
                        android:button="@null" />

                    <RadioButton
                        android:id="@+id/securitybtn"
                        style="@style/riderprofiletogglestyle"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:padding="8dp"
                        android:textSize="19dp"
                        android:textColor="#FFFFFF"
                        android:button="@null" />

                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ==================== BASIC TAB ==================== -->
        <LinearLayout
            android:id="@+id/basicContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="20dp"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/kanit"
                    android:text="Name"
                    android:layout_marginEnd="20dp"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="380dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_edittext_border"
                    android:fontFamily="@font/kanit"
                    android:hint="Enter Name"
                    android:inputType="textPersonName"
                    android:textColor="@color/white"
                    android:textColorHint="#808080"
                    android:textSize="22sp"
                    android:paddingStart="30dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/kanit"
                    android:text="Phone"
                    android:layout_marginBottom="6dp"
                    android:layout_marginEnd="20dp"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="380dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_edittext_border"
                    android:fontFamily="@font/kanit"
                    android:hint="Enter Phone Number"
                    android:layout_marginStart="-5dp"
                    android:inputType="number"
                    android:textColor="@color/white"
                    android:textColorHint="#808080"
                    android:textSize="22sp"
                    android:paddingStart="30dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/kanit"
                    android:text="Age"
                    android:layout_marginBottom="6dp"
                    android:layout_marginEnd="20dp"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="380dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_edittext_border"
                    android:fontFamily="@font/kanit"
                    android:hint="Enter Age"
                    android:layout_marginStart="18dp"
                    android:inputType="number"
                    android:textColor="@color/white"
                    android:textColorHint="#808080"
                    android:textSize="22sp"
                    android:maxLength="2"
                    android:paddingStart="30dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>


        </LinearLayout>



        <!-- ==================== SECURITY TAB ==================== -->
        <LinearLayout
            android:id="@+id/securityContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <!-- PIN INPUT -->
                <LinearLayout
                    android:id="@+id/pinContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="19dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvEnterPin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/kanit"
                            android:text="Enter PIN"
                            android:layout_marginEnd="43dp"
                            android:textColor="#FFFFFF"
                            android:textSize="23sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <EditText
                            android:id="@+id/etPin"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rounded_edittext_border"
                            android:fontFamily="@font/kanit"
                            android:hint="Enter PIN"
                            android:inputType="numberPassword"
                            android:textColor="@color/white"
                            android:textColorHint="#808080"
                            android:textSize="22sp"
                            android:paddingStart="30dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="17dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvConfirmPin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/kanit"
                            android:text="Confirm PIN"
                            android:layout_marginEnd="20dp"
                            android:textColor="#FFFFFF"
                            android:textSize="23sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <EditText
                            android:id="@+id/etPinConfirm"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rounded_edittext_border"
                            android:fontFamily="@font/kanit"
                            android:hint="Confrim PIN"
                            android:inputType="numberPassword"
                            android:textColor="@color/white"
                            android:textColorHint="#808080"
                            android:textSize="22sp"
                            android:paddingStart="30dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </LinearLayout>
                </LinearLayout>


                <!-- ⭐ PATTERN SECTION — CENTERED BELOW PIN EXACTLY -->

                <com.fanconn.rideOS.authen.PatternViewRegister
                    android:id="@+id/patternViewRegister"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/TVdrawpat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Draw Pattern"
                    android:layout_marginTop="15dp"
                    android:textColor="#9D9D9D"
                    android:textSize="21sp"
                    android:fontFamily="@font/kanit"
                    android:visibility="gone"/>


                <com.fanconn.rideOS.authen.PatternViewRegister
                    android:id="@+id/patternViewConfirm"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/TVconfirmpat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Confirm Pattern"
                    android:textColor="#9D9D9D"
                    android:layout_marginTop="15dp"
                    android:textSize="21sp"
                    android:fontFamily="@font/kanit"
                    android:visibility="gone"/>
                <Button
                    android:id="@+id/btnClearPattern"
                    android:layout_width="180dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="15dp"
                    android:text="Clear Pattern"
                    android:textSize="18sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/rounded_edittext_border"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ==================== ADVANCED TAB ==================== -->
        <LinearLayout
            android:id="@+id/advancedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- MAX SPEED -->
            <!-- SPEED + TORQUE IN SAME ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="40dp">

                <!-- ================= SPEED ================= -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="53dp"
                    android:orientation="horizontal"
                    >
                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speed"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:fontFamily="@font/kanit" />

                        <TextView
                            android:id="@+id/tvMaxspeedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100 kmph"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />
                    </LinearLayout>
                        <FrameLayout
                            android:layout_width="260dp"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:layout_marginStart="25dp"
                           >

                            <SeekBar
                                android:id="@+id/seekBarMaxSpeed"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="40"
                                android:progress="40"
                                android:paddingStart="25dp"
                                android:paddingEnd="25dp"
                                android:thumb="@drawable/reverse_speed_seekbarthumb"
                                android:progressTint="#FFEE00"
                                android:progressBackgroundTint="#FFFFFF" />
                        </FrameLayout>



                </LinearLayout>

                <!-- ================= TORQUE ================= -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="30dp"
                    android:orientation="horizontal"
                   >
                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Torque"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:fontFamily="@font/kanit" />
                    <TextView
                        android:id="@+id/tvTorqueLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lvl 2"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:fontFamily="@font/kanit"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                       >
                    <SeekBar
                        android:id="@+id/seekBarTorque"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:max="4"
                        android:progress="4"
                        android:paddingStart="35dp"
                        android:paddingEnd="25dp"
                        android:thumb="@drawable/reverse_speed_seekbarthumb"
                        android:progressTint="#F88213"
                        android:progressBackgroundTint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="5"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1"
                            android:textColor="#00E5FF"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2"
                            android:textColor="#2AFF00"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3"
                            android:textColor="#FFEE00"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="4"
                            android:textColor="#FC7E09"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="5"
                            android:textColor="#FF4040"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />
                    </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            <!-- ACCELERATION + BRAKING IN SAME ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginStart="53dp"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="65dp">

                <!-- ================= ACCELERATION ================= -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acceleration"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:fontFamily="@font/kanit" />

                        <TextView
                            android:id="@+id/tvPickupLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lvl 2"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit"
                            android:layout_marginTop="5dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        >
                    <SeekBar
                        android:id="@+id/seekBarPickup"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:max="4"
                        android:progress="4"
                        android:paddingStart="25dp"
                        android:paddingEnd="35dp"
                        android:thumb="@drawable/reverse_speed_seekbarthumb"
                        android:progressTint="#F88213"
                        android:progressBackgroundTint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:gravity="center">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1"
                            android:textColor="#00E5FF"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2"
                            android:textColor="#2AFF00"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3"
                            android:textColor="#FFEE00"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />
                    </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- ================= BRAKING ================= -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginStart="25dp">
                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="eBraking"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="10dp"
                        android:textSize="21sp"
                        android:fontFamily="@font/kanit" />

                        <TextView
                            android:id="@+id/tvBrakingLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lvl 2"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit"
                            android:layout_marginTop="5dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="28dp"
                        android:orientation="vertical">

                    <SeekBar
                        android:id="@+id/seekBarBraking"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:max="5"
                        android:progress="2"
                        android:paddingStart="25dp"
                        android:paddingEnd="35dp"
                        android:thumb="@drawable/reverse_speed_seekbarthumb"
                        android:progressTint="#F88213"
                        android:progressBackgroundTint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="6"
                        android:gravity="center"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1"
                            android:textColor="#00E5FF"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:fontFamily="@font/kanit" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2"
                            android:textColor="#2AFF00"
                            android:gravity="center"
