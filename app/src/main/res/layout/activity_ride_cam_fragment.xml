<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fragmentbg">

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="22dp"
            android:paddingEnd="33dp"
            app:layout_constraintTop_toTopOf="@+id/scrollViewContent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <!-- Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanitlite"
                        android:paddingEnd="15dp"
                        android:text="Video Resolution"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit"
                        android:paddingTop="10dp"
                        android:text="Higher resolution videos use more storage"
                        android:textColor="#7D7D7D"
                        android:textSize="17sp" />

                </LinearLayout>

                <RadioGroup
                    android:id="@+id/RecQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/Q480"
                        style="@style/ToggleStyle"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:layout_marginEnd="22dp"
                        android:fontFamily="@font/kanit"
                        android:text="480p"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/Q720"
                        style="@style/ToggleStyle"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/kanit"
                        android:text="720p" />

                    <RadioButton
                        android:id="@+id/Q1080"
                        style="@style/ToggleStyle"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:fontFamily="@font/kanit"
                        android:text="1080p" />
                </RadioGroup>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:paddingVertical="8dp">

                <!-- Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Recording Settings"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="32sp"
                        android:paddingEnd="15dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="When enabled, the dashcam will begin recording automatically at startup"
                        android:textColor="#7D7D7D"
                        android:paddingBottom="5dp"
                        android:fontFamily="@font/kanit"
                        android:textSize="17sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/autoRecordingbtn"
                        android:layout_width="154dp"
                        android:layout_height="58dp"
                        android:layout_gravity="end"
                        android:layout_marginEnd="36dp"
                        android:fontFamily="@font/kanitlite"
                        android:gravity="center"
                        android:scaleX="1.4"
                        android:scaleY="1.4"
                        android:text="Auto Rec"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="Video recording starts when scooter is unlocked"
                        android:textColor="#7D7D7D"
                        android:paddingBottom="5dp"
                        android:fontFamily="@font/kanit"
                        android:textSize="17sp" />
                </LinearLayout>
                <!-- Switch aligned right -->

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <!-- Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanitlite"
                        android:paddingEnd="15dp"
                        android:text="Video Retention Duration"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit"
                        android:paddingTop="10dp"
                        android:text="Automatically delete the footage older than selected duration"
                        android:textColor="#7D7D7D"
                        android:textSize="17sp" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/Theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/DarkTheme"
                        style="@style/ToggleStyle"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:layout_marginEnd="22dp"
                        android:fontFamily="@font/kanit"
                        android:text="1 Month"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/LightThem"
                        style="@style/ToggleStyle"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/kanit"
                        android:text="1 Week" />

                    <RadioButton
                        android:id="@+id/AutoTheme"
                        style="@style/ToggleStyle"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:fontFamily="@font/kanit"
                        android:text="1 Day" />
                </RadioGroup>
            </LinearLayout>

         <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <!-- Text Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audio-Recording"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/kanitlite"
                    android:textSize="32sp"
                    android:paddingEnd="15dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Record high quality audio in video"
                    android:textColor="#7D7D7D"
                    android:paddingBottom="5dp"
                    android:fontFamily="@font/kanit"
                    android:textSize="17sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoAudioRecbtn"
                    android:layout_width="154dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="32dp"
                    android:fontFamily="@font/kanitlite"
                    android:gravity="center"
                    android:scaleX="1.4"
                    android:layout_gravity="end"
                    android:scaleY="1.4"
                    android:text="Audio Rec"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:layout_gravity="end"
                    android:text="Enabling audio recording may affect privacy and storage usage"
                    android:textColor="#7D7D7D"
                    android:paddingBottom="5dp"
                    android:fontFamily="@font/kanit"
                    android:textSize="17sp" />
            </LinearLayout>
         </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="24dp"
                android:paddingVertical="8dp">

                <!-- Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Storage"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="32sp"
                        android:paddingEnd="15dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="Details of internal storage"
                        android:textColor="#7D7D7D"
                        android:paddingBottom="5dp"
                        android:fontFamily="@font/kanit"
                        android:textSize="17sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="96.2% of 64GB available"
                        android:textColor="#FFFFFF"
                        android:paddingBottom="5dp"
                        android:fontFamily="@font/kanit"
                        android:textSize="20sp" />
                    <Button
                        android:id="@+id/ltetoggle"
                        android:layout_width="120dp"
                        android:layout_height="35dp"
                        android:layout_gravity="end"
                        android:text="Erase"
                        android:fontFamily="@font/kanit"
                        android:textAllCaps="false"
                        android:textColor="#FF2B00"
                        android:textSize="16dp"
                        android:background="@drawable/format_button"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                 </LinearLayout>
             </LinearLayout>
             </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>