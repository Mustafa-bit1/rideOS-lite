<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/local_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:layout_marginTop="10dp"
        android:background="#ffffff">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/local_get_back"
                android:layout_width="@dimen/image_width"
                android:layout_height="wrap_content"
                android:src="@drawable/get_back"
                android:onClick="local_get_back"
                android:layout_gravity="left" />

            <TextView
                android:id="@+id/pattern"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/local_update_mode"
                android:textColor="#000000"
                android:textSize="@dimen/text_size_large" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>


    <TextView
        android:id="@+id/textModule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textSize="@dimen/text_size_large"
        android:translationY="80dp"
        android:text="fanconn sc126" />

    <TextView
        android:id="@+id/textProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textSize="@dimen/text_size_large"
        android:layout_marginTop="@dimen/margin_small"
        android:translationY="110dp"
        android:text="Face access control" />

    <TextView
        android:id="@+id/textVersions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textSize="@dimen/text_size_large"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_below="@id/textProduct"
        android:translationY="100dp"
        android:text="A12_1.0" />

    <TextView
        android:id="@+id/progressBarState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginTop="5dp"
        android:layout_centerHorizontal="true"
        android:translationY="460dp"
        android:visibility="visible"
        android:text="@string/updating"
        android:textSize="@dimen/text_size_medium" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="@dimen/progress_bar_width"
        android:layout_height="@dimen/progress_bar_height"
        android:max="100"
        android:min="0"
        android:visibility="visible"
        android:translationY="60dp"
        android:progressDrawable="@drawable/my_progressbar"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>

    <TextView
        android:id="@+id/progressValue"
        android:layout_width="@dimen/progress_bar_width"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/progressBar"
        android:layout_marginStart="@dimen/margin_small"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:translationY="80dp"
        android:text="0%"
        android:textColor="#88d3d0"
        android:visibility="visible"
        android:textSize="@dimen/text_size_medium" />

    <Button
        android:id="@+id/Start_update"
        android:layout_width="@dimen/button_width"
        android:layout_height="@dimen/button_height"
        android:layout_centerVertical="true"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:onClick="onStartUpdateClick"
        android:translationY="100dp"
        android:text="@string/start_updating"
        android:textSize="@dimen/text_size_large"
        android:textColor="#6c6868"
        android:layout_marginBottom="@dimen/large_margin_vertical"
        android:background="@drawable/custom_button"
        />


    <Spinner
        android:id="@+id/spinnerConfigs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/Start_update"
        android:layout_marginTop="4dp"
        android:visibility="invisible"/>

</RelativeLayout>