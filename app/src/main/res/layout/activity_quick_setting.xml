<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="1280dp"
    android:layout_height="480dp"
    android:background="@drawable/quicksetbg"
    tools:context=".QuickSetting">

    <!-- Brightness & Volume Containers Side-by-side -->
    <LinearLayout
        android:id="@+id/topControlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:orientation="horizontal"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="41dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Brightness Control -->
        <LinearLayout
            android:id="@+id/brightnessContainer"
            android:layout_width="0dp"
            android:layout_height="124dp"
            android:layout_weight="1"
            android:background="@drawable/seekbar_container_bg"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:gravity="center_vertical"
                >

                <TextView
                    android:id="@+id/brightnessLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brightness"
                    android:fontFamily="@font/kanit"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/autoBrightnessText"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="248dp"
                    android:fontFamily="@font/kanitlite"
                    android:text="90%"
                    android:textAlignment="textEnd"
                    android:textColor="#FFEB3B"
                    android:textSize="17sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/brightnessSlider"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:max="255"
                android:progressDrawable="@drawable/custom_seekbar"
                android:splitTrack="false"
                android:thumb="@drawable/brigness_seekbarhtumb"
                android:thumbTint="@null" />


        </LinearLayout>


        <!-- Volume Control -->
        <LinearLayout
            android:id="@+id/volumeContainer"
            android:layout_width="0dp"
            android:layout_height="124dp"
            android:layout_marginStart="30dp"
            android:layout_weight="1"
            android:background="@drawable/seekbar_container_bg"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/volumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/kanit"
                android:text="Volume"
                android:layout_marginStart="14dp"

                android:textColor="#FFFFFF"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <ImageButton
                    android:id="@+id/muteButton"
                    android:layout_width="59dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:adjustViewBounds="true"
                    android:background="@android:color/transparent"
                    android:contentDescription="Mute toggle"
                    android:scaleType="fitXY"
                    android:src="@drawable/unmutted" />
                <SeekBar
                    android:id="@+id/volumeSlider"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:max="255"
                    android:layout_marginEnd="5dp"
                    android:progressDrawable="@drawable/custom_seekbar"
                    android:splitTrack="false"
                    android:thumb="@drawable/volumebar_thumb"
                    android:thumbTint="@null" />


            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Buttons Row -->
    <LinearLayout
        android:id="@+id/toggleButtonsContainer"
        android:layout_width="1200dp"
        android:layout_height="124dp"
        android:layout_marginTop="264dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/seekbar_container_bg"
        android:elevation="6dp"
        android:padding="8dp">

        <!-- Wi-Fi -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/wifiToggle"
                style="@style/QuickButtonStyle"
                android:text="Wi-Fi"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:backgroundTint="#555555"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/wifiStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/kanit"
                android:gravity="center"
                android:layout_marginTop="2dp"/>
        </LinearLayout>


        <!-- 4G -->
<!--        <LinearLayout-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="match_parent"-->
<!--            android:layout_weight="1"-->
<!--            android:orientation="vertical"-->
<!--            android:gravity="center">-->

<!--            <Button-->
<!--                android:id="@+id/ltetoggle"-->
<!--                style="@style/QuickButtonStyle"-->
<!--                android:text="Device Data"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="0dp"-->
<!--                android:layout_weight="1"-->
<!--                android:backgroundTint="#555555"-->
<!--                android:textColor="#FFFFFF"/>-->
<!--            <TextView-->
<!--                android:id="@+id/ltetoggleStatusText"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text=""-->
<!--                android:textColor="#FFFFFF"-->
<!--                android:textSize="12sp"-->
<!--                android:gravity="center"-->
<!--                android:fontFamily="@font/kanit"-->
<!--                android:layout_marginTop="2dp"/>-->
<!--        </LinearLayout>-->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/autoBrightnessToggle"
                style="@style/QuickButtonStyle"
                android:text="Brightness"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:backgroundTint="#555555"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/autoBrightnessStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/kanit"
                android:gravity="center"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <!-- Bluetooth -->


        <!-- Sounds -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/blue_tpmsbtn"
                style="@style/QuickButtonStyle"
                android:text="TPMS"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:backgroundTint="#1C78BE"
                android:textColor="#FFFFFF"/>
            <TextView
                android:id="@+id/soundstoggleStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tyre pressure"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/Settingbtn"
                style="@style/QuickButtonStyle"
                android:text="New feature"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:backgroundTint="#1C78BE"
                android:textColor="#FFFFFF"/>

            <!-- Optional: Add status TextView for Bluetooth too -->
            <TextView
                android:id="@+id/bluetoothStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:fontFamily="@font/kanit"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Right Buttons -->
