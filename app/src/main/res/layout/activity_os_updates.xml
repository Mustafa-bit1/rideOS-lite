<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fragmentbg"
    tools:context="com.fanconn.rideOS.menu.OS_UpdatesFragment">

    <!-- Header Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/osUpdateCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardUseCompatPadding="true"
    app:cardBackgroundColor="#3B3B3B"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:paddingEnd="30dp"
            android:paddingStart="20dp">

            <!-- MAIN CONTENT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <TextView
                    android:id="@+id/server_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit"
                    android:text="Latest Version -"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/server_release_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit"
                    android:text="Release Date: -"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/server_version" />

                <!-- SEE WHAT'S NEW ROW -->
                <LinearLayout
                    android:id="@+id/layoutWhatsNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/server_release_date">

                    <ImageButton
                        android:id="@+id/arrowdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:src="@drawable/arrowdown"
                        />
                </LinearLayout>


                <ImageButton
                    android:id="@+id/otaupdatebtn"
                    android:layout_width="180dp"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/otaupdatebtn"
                    android:scaleType="fitXY"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- EXPANDABLE SECTION -->
            <!-- EXPANDABLE SECTION -->
            <LinearLayout
                android:id="@+id/layoutReleaseNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="14dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#444444"
                    android:layout_marginBottom="10dp"/>

                <!-- SCROLLABLE RELEASE NOTES -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/tvReleasePoints"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#DDDDDD"
                        android:textSize="23sp"
                        android:layout_marginStart="20dp"
                        android:lineSpacingExtra="6dp"
                        android:fontFamily="@font/kanitlite"/>
                </ScrollView>

            </LinearLayout>


        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- Scrollable Content Section -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/osUpdateCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <!-- Current Version -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/kanitlite"
                    android:paddingStart="1dp"
                    android:text="Current version"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanitlite"
                        android:paddingEnd="1dp"
                        android:text="rideOS"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp" />

                    <TextView
                        android:id="@+id/installeddate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanitlite"
                        android:text=""
                        android:textColor="#CCCCCC"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
<!--            <ImageButton-->
<!--                android:id="@+id/Fmcuotaupdatebtn"-->
<!--                android:layout_width="180dp"-->
<!--                android:layout_height="52dp"-->
<!--                android:background="@android:color/transparent"-->
<!--                android:src="@drawable/otaupdatebtn"-->
<!--                android:scaleType="fitXY"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintTop_toTopOf="parent"-->
<!--                app:layout_constraintBottom_toBottomOf="parent" />-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="15dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/kanitlite"
                    android:paddingStart="1dp"
                    android:text="rideOS uptime"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/tvUptime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanitlite"
                    android:paddingEnd="1dp"
                    android:text="0d 00:00"
                    android:textColor="#FFFFFF"
                    android:textAlignment="textStart"
                    android:textSize="25sp" />
            </LinearLayout>


            <!-- Build Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="15dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/kanitlite"
                    android:paddingStart="1dp"
                    android:text="Build number"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/buildnum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanitlite"
                    android:paddingEnd="1dp"
                    android:text="rideOS_base"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- Device Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/kanitlite"
                    android:paddingStart="1dp"
                    android:text="Device Name"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/devicenameTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanitlite"
                    android:paddingEnd="1dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/kanitlite"
                    android:paddingStart="1dp"
                    android:text="Firmware version"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/firmwareV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanitlite"
                        android:paddingEnd="1dp"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="25sp" />

                </LinearLayout>

            </LinearLayout>

<!--            <LinearLayout-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:orientation="horizontal"-->
<!--                android:paddingVertical="20dp">-->

<!--                <TextView-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_weight="1"-->
<!--                    android:fontFamily="@font/kanitlite"-->
<!--                    android:paddingStart="1dp"-->
<!--                    android:text="Device Bluetooth"-->
<!--                    android:textColor="#FFFFFF"-->
<!--                    android:textSize="23sp" />-->

<!--                <LinearLayout-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:orientation="vertical">-->

<!--                    <TextView-->
<!--                        android:id="@+id/bluetoothTV"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:fontFamily="@font/kanitlite"-->
<!--                        android:paddingEnd="1dp"-->
<!--                        android:text=""-->
<!--                        android:textColor="#FFFFFF"-->
<!--                        android:textSize="25sp" />-->

<!--                </LinearLayout>-->

<!--            </LinearLayout>-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="20dp"
                >

                <!-- Text Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanitlite"
                        android:text="4G Data"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/kanitlite"
                        android:text="Recommended to keep data always ON"
                        android:textColor="#BBBBBB"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Button -->
                <Button
                    android:id="@+id/ltetoggle"
                    android:layout_width="180dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_vertical"
                    android:text="Data"
                    android:textAllCaps="false"
                    android:layout_marginEnd="30dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rounded_square_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

            </LinearLayout>


        </LinearLayout>


    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
