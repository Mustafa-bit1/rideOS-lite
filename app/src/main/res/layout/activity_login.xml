    <Button
        android:id="@+id/launchSettings"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginTop="408dp"
        android:layout_marginEnd="40dp"
        android:background="@android:color/transparent"
        android:text=""
        android:alpha="0"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="false"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/chargingStatus"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:layout_marginBottom="52dp"
        android:fontFamily="@font/kanit"
        android:text="Charging"
        android:textAlignment="center"
        android:textColor="#00C853"
        android:textSize="20sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include layout="@layout/custom_keypadd"
        android:id="@+id/customKeypad"
        />

    <ImageView
        android:id="@+id/loginchargingicon"
        android:layout_width="138dp"
        android:layout_height="24dp"
        android:layout_marginTop="427dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"
        app:srcCompat="@drawable/chargingicon" />


    <TextView
        android:id="@+id/tempWarningMessage"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="464dp"
        android:layout_marginBottom="-8dp"
        android:fontFamily="@font/kanit"
        android:gravity="center"
        android:padding="10dp"
        android:visibility="gone"
        android:text="High Battery Temperature Detected"
        android:textColor="#FF0000"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

