<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="1280dp"
    android:layout_height="480dp"
    android:background="@drawable/bg"
    tools:context=".debugPage">

    <LinearLayout
        android:id="@+id/debugPageLayout"
        android:layout_width="200dp"
        android:layout_height="00dp"
        android:layout_marginStart="548dp"
        android:layout_marginTop="108dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnStartDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#DA6200"
            android:foreground="@drawable/btn_click_effect"
            android:text="Start Debug" />

        <Button
            android:id="@+id/btnStopDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#DA6200"
            android:foreground="@drawable/btn_click_effect"
            android:text="Stop Debug" />

    </LinearLayout>

    <Button
        android:id="@+id/btnResetCounters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="578dp"
        android:layout_marginTop="270dp"
        android:backgroundTint="#DA6200"
        android:foreground="@drawable/btn_click_effect"
        android:text="Reset Counters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/backbtn"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:background="@android:color/transparent"
        android:foreground="@drawable/btn_click_effect"
        android:scaleType="fitCenter"
        android:src="@drawable/rreturn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/counterContainer"
        android:layout_width="500dp"
        android:layout_height="200dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="68dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- LED On -->
        <TextView
            android:id="@+id/ledOnCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:text="LED On : 0" />



        <!-- Handle Lock Open -->
        <TextView
            android:id="@+id/handleOpenCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:layout_marginTop="8dp"

            android:text="Handle Lock Open : 0" />

        <!-- Handle Lock Close -->
        <TextView
            android:id="@+id/handleCloseCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:layout_marginTop="8dp"

            android:text="Handle Lock Close : 0" />

        <!-- Seat Lock Activate -->
        <TextView
            android:id="@+id/seatLockCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:layout_marginTop="8dp"
            android:text="Seat Lock Activated : 0" />

        <!-- LED Off -->
        <TextView
            android:id="@+id/ledOffCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/kanit"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:text="LED Off : 0" />

        <!-- Reset Button -->

    </LinearLayout>


    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="864dp"
        android:layout_marginTop="324dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/deviceNameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:paddingBottom="8dp"
            android:text="Device Name:"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/buildNumberView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:paddingBottom="8dp"
            android:text="Build Number:"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/bluetoothNameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:paddingBottom="8dp"
            android:text="Bluetooth Name:"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/wifiSsidView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:paddingBottom="8dp"
            android:text="WiFi SSID:"
            android:textColor="@color/white"
            android:textSize="18sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="183dp"
        android:layout_height="34dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/kanit"
        android:text="Counts"
        android:textColor="@color/white"
        android:textSize="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>