            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:paddingVertical="8dp">

                <!-- Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Volume"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="32sp"
                        android:paddingEnd="15dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="Controls the entire device sounds"
                        android:textColor="#7D7D7D"
                        android:fontFamily="@font/kanit"
                        android:textSize="17sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/muteButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/unmutted"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="17dp"
                    android:contentDescription="Mute toggle"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true" />


                <SeekBar
                    android:id="@+id/volumeSlider"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="4dp"
                    android:paddingEnd="15dp"
                    android:layout_weight="1"
                    android:progressDrawable="@drawable/custom_seekbar"
                    android:thumb="@drawable/volumebar_thumb"
                    android:thumbTint="@null"
                    android:splitTrack="false"/>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:paddingVertical="8dp">

                <!-- Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto lock timer"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="32sp"
                        android:paddingEnd="15dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="Set auto scooter lock time"
                        android:textColor="#7D7D7D"
                        android:fontFamily="@font/kanit"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- Switch aligned right -->
                <SeekBar
                    android:id="@+id/seek_inactivity"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingStart="40dp"
                    android:paddingEnd="30dp"
                    android:layout_marginEnd="10dp"
                    android:max="9"
                    android:progressTint="#0283FF"
                    android:progressBackgroundTint="#FFFFFF"
                    android:thumb="@drawable/reverse_speed_seekbarthumb"
                   />

                <TextView
                    android:id="@+id/tv_inactivity_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="21dp"
                    android:fontFamily="@font/kanit"
                    android:textAlignment="textEnd"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="27sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:paddingVertical="8dp">

                <!-- Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="comfortKey"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="32sp"
                        android:paddingEnd="15dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="choose comforKey mode"
                        android:textColor="#7D7D7D"
                        android:fontFamily="@font/kanit"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- Switch aligned right -->
                <SeekBar
                    android:id="@+id/seek_rssi_threshold"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingStart="40dp"
                    android:paddingEnd="30dp"
                    android:thumb="@drawable/reverse_speed_seekbarthumb"
                    android:progressTint="#0283FF"
                    android:progressBackgroundTint="#FFFFFF"
                    />

                <TextView
                    android:id="@+id/tv_rssi_value"
                    android:layout_width="112dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:fontFamily="@font/kanit"
                    android:textAlignment="center"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="27sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:paddingVertical="8dp">

                <!-- Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boost duration"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="32sp"
                        android:paddingEnd="15dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="Boost duration"
                        android:textColor="#7D7D7D"
                        android:fontFamily="@font/kanit"
                        android:textSize="17sp" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/boostduration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/boost5sec"
                        style="@style/ToggleStyle"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:layout_marginEnd="22dp"
                        android:fontFamily="@font/kanit"
                        android:text="5 sec" />

                    <RadioButton
                        android:id="@+id/boost8sec"
                        style="@style/ToggleStyle"
                        android:fontFamily="@font/kanit"
                        android:layout_width="120dp"
                        android:layout_marginEnd="20dp"
                        android:layout_height="78dp"
                        android:text="8 sec" />

                    <RadioButton
                        android:id="@+id/boost12sec"
                        style="@style/ToggleStyle"
                        android:fontFamily="@font/kanit"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:text="12 sec" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:paddingVertical="8dp">

                <!-- Text Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boost interval"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="32sp"
                        android:paddingEnd="15dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="Next boost activation time"
                        android:textColor="#7D7D7D"
                        android:fontFamily="@font/kanit"
                        android:textSize="17sp" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/boostlasting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/boostLast45"
                        style="@style/ToggleStyle"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:layout_marginEnd="22dp"
                        android:fontFamily="@font/kanit"
                        android:text="45 sec" />

                    <RadioButton
                        android:id="@+id/boostLast60"
                        style="@style/ToggleStyle"
                        android:fontFamily="@font/kanit"
                        android:layout_width="120dp"
                        android:layout_marginEnd="20dp"
                        android:layout_height="78dp"
                        android:text="1 min" />

                    <RadioButton
                        android:id="@+id/boostLast90"
                        style="@style/ToggleStyle"
                        android:fontFamily="@font/kanit"
                        android:layout_width="120dp"
                        android:layout_height="78dp"
                        android:text="1.5 min" />
                </RadioGroup>
            </LinearLayout>
            <!-- ROLL PROTECT Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:paddingVertical="8dp">

                <!-- Text Column -->

                <!-- Switch aligned right -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanitlite"
                        android:paddingEnd="15dp"
                        android:text="rollProtect"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit"
                        android:paddingTop="10dp"
                        android:text="Prevent rolling backward on slopes, Recommended to keep this ON everytime"
                        android:textColor="#7D7D7D"
                        android:textSize="17sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/rollprotectSwitch"
                    android:layout_width="174dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/kanitlite"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingEnd="20dp"
                    android:scaleX="1.4"
                    android:scaleY="1.4"
                    android:text="Roll: ON"
                    android:textColor="@color/white"
                     />
            </LinearLayout>
