<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="1280dp"
    android:layout_height="480dp"
    android:background="@drawable/updatebar">

    <ImageView
        android:id="@+id/otssuccesimg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="158dp"
        android:layout_marginEnd="539dp"
        android:visibility="gone"
        android:src="@drawable/otasucces3" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="440dp"
        android:layout_marginBottom="138dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_bar_custom" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="87dp"
        android:gravity="center"
        android:textAlignment="center"
        android:fontFamily="@font/kanit"
        android:text="Downloading..."
        android:textColor="@color/white"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/statuspercentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="388dp"
        android:layout_marginBottom="135dp"
        android:fontFamily="@font/kanit"
        android:gravity="center"
        android:text="100%"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="22sp" />


</RelativeLayout>
