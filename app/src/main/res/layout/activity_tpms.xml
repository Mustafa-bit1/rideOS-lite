<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="1280dp"
    android:layout_height="480dp"
    android:background="@drawable/tpmsbg"
    tools:context=".TPMS_activity">

    <Button
        android:id="@+id/btnResync"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginStart="36dp"
        android:layout_marginBottom="176dp"

        android:text="Re-Sync"
        android:fontFamily="@font/kanit"
        android:textColor="@android:color/white"
        android:textSize="18dp"
        android:drawableStart="@drawable/tpms_resync_ic"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"

        android:background="@drawable/rounded_square_button"
        android:backgroundTint="#1C78BE"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageButton
        android:id="@+id/backbtntpms"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/rreturn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/settingsParent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <TextView
            android:id="@+id/powered_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:lineSpacingExtra="2dp"
            android:text="Powered by alerTire"
            android:textColor="@color/white"
            android:textSize="19sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:paddingBottom="9dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/alertireicons1"

            />

    </LinearLayout>


    <androidx.cardview.widget.CardView
        android:id="@+id/tpmsStatusCard"
        android:layout_width="472dp"
        android:layout_height="112dp"
        android:layout_marginStart="38dp"
        android:layout_marginBottom="242dp"
        android:backgroundTint="#262626"
        android:padding="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tpmsStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/kanit"
            android:lineSpacingExtra="2dp"

            android:text="Please install the TPMS sensor on your nx100 to monitor tire pressure and temperature in real time."
            android:textColor="@color/white"
            android:textSize="19dp" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="13dp"
            android:src="@drawable/iicon" />
    </androidx.cardview.widget.CardView>
<!--    <TextView-->
<!--        android:id="@+id/bluetoothOnmsg"-->
<!--        android:layout_width="411dp"-->
<!--        android:layout_height="50dp"-->
<!--        android:layout_marginEnd="828dp"-->
<!--        android:layout_marginBottom="148dp"-->
<!--        android:fontFamily="@font/kanitlite"-->
