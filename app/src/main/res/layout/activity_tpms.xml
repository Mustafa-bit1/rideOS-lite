<!--        android:text="Ensure your scooter bluetooth is ON to get TPMS data realtime."-->
<!--        android:textColor="@color/white"-->
<!--        android:textSize="17dp"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent" />-->

    <TextView
        android:id="@+id/tpmsbluetoothstatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="118dp"
        android:fontFamily="@font/kanit"
        android:gravity="center"
        android:text="Device bluetooth OFF, sensor data may not be updated."
        android:textColor="#C10000"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="107dp"
        android:layout_height="86dp"
        android:layout_marginStart="548dp"
        android:layout_marginTop="320dp"
        app:cardBackgroundColor="#262626"
        app:cardCornerRadius="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Example child inside the CardView -->



        <TextView
            android:id="@+id/rearpressurevalue"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/kanit"
            android:text="- psi"
            android:textColor="@android:color/white"
            android:textSize="22dp" />

        <TextView
            android:id="@+id/reartempvalue"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="45dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/kanit"
            android:text="- °C"
            android:textColor="@android:color/white"
            android:textSize="22dp" />


    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="107dp"
        android:layout_height="86dp"
        android:layout_marginStart="1132dp"
        android:layout_marginTop="320dp"
        app:cardBackgroundColor="#262626"
        app:cardCornerRadius="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Example child inside the CardView -->



        <TextView
            android:id="@+id/frontpressurevalue"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/kanit"
            android:text="- psi"
            android:textColor="@android:color/white"
            android:textSize="22dp" />

        <TextView
            android:id="@+id/fronttempvalue"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="45dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/kanit"
            android:text="- °C"
            android:textColor="@android:color/white"
            android:textSize="22dp" />


    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/reartpmsIdealStatus"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:layout_marginTop="255dp"
        android:layout_marginEnd="590dp"
        android:fontFamily="@font/kanit"
        android:lineSpacingExtra="-20dp"
        android:text="No sensor detected"
        android:textAlignment="center"
        android:textColor="#3BFF21"
        android:textSize="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/fronttpmsIdealStatus"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:layout_marginTop="255dp"
        android:layout_marginEnd="10dp"
        android:fontFamily="@font/kanit"
        android:lineSpacingExtra="-20dp"
        android:text="No sensor detected"
        android:textAlignment="center"
        android:textColor="#FFC30F"
        android:textSize="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



    <ImageView
        android:id="@+id/tpmsbikeIMG"
        android:layout_width="486dp"
        android:layout_height="332dp"
        android:layout_marginTop="116dp"
        android:layout_marginEnd="152dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/tpmsgg" />


</androidx.constraintlayout.widget.ConstraintLayout>