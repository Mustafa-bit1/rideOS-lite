<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="1280dp"
    android:layout_height="480dp"
    android:background="@drawable/tpmsbg"
    tools:context=".TPMS_activity">

    <ImageButton
        android:id="@+id/backbtntpms"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/rreturn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/tpmsStatusCard"
        android:layout_width="462dp"
        android:layout_height="112dp"
        android:layout_marginStart="38dp"
        android:layout_marginBottom="242dp"
        android:backgroundTint="#262626"
        android:padding="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tpmsStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/kanit"
            android:lineSpacingExtra="2dp"
            android:text="Please install the TPMS sensor on your nx100 to monitor tire pressure and temperature in real time."
            android:textColor="@color/white"
            android:textSize="19dp" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/iicon" />
    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/bluetoothOnmsg"
        android:layout_width="411dp"
        android:layout_height="50dp"
        android:layout_marginEnd="828dp"
        android:layout_marginBottom="148dp"
        android:fontFamily="@font/kanitlite"
        android:lineSpacingExtra="2dp"
        android:text="Ensure your scooter bluetooth is ON to get TPMS data realtime."
        android:textColor="@color/white"
        android:textSize="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tpmsbluetoothstatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="118dp"
        android:fontFamily="@font/kanit"
        android:gravity="center"
        android:text="Device bluetooth OFF, sensor data may not be updated."
        android:textColor="#C10000"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="107dp"
        android:layout_height="86dp"
        android:layout_marginStart="548dp"
        android:layout_marginTop="320dp"
        app:cardBackgroundColor="#262626"
        app:cardCornerRadius="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Example child inside the CardView -->



        <TextView
            android:id="@+id/rearpressurevalue"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/kanit"
            android:text="- psi"
            android:textColor="@android:color/white"
            android:textSize="22dp" />

        <TextView
            android:id="@+id/reartempvalue"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="45dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/kanit"
            android:text="- °C"
            android:textColor="@android:color/white"
            android:textSize="22dp" />


    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="107dp"
        android:layout_height="86dp"
        android:layout_marginStart="1132dp"
        android:layout_marginTop="320dp"
        app:cardBackgroundColor="#262626"
        app:cardCornerRadius="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Example child inside the CardView -->



        <TextView
            android:id="@+id/frontpressurevalue"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/kanit"
            android:text="- psi"
            android:textColor="@android:color/white"
            android:textSize="22dp" />

        <TextView
            android:id="@+id/fronttempvalue"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="45dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/kanit"
            android:text="- °C"
            android:textColor="@android:color/white"
            android:textSize="22dp" />


    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/reartpmsIdealStatus"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:layout_marginTop="255dp"
        android:layout_marginEnd="590dp"
        android:fontFamily="@font/kanit"
        android:lineSpacingExtra="-20dp"
        android:text="No sensor detected"
        android:textAlignment="center"
        android:textColor="#3BFF21"
        android:textSize="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/fronttpmsIdealStatus"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:layout_marginTop="255dp"
        android:layout_marginEnd="10dp"
        android:fontFamily="@font/kanit"
        android:lineSpacingExtra="-20dp"
        android:text="No sensor detected"
        android:textAlignment="center"
        android:textColor="#FFC30F"
        android:textSize="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



    <ImageView
        android:id="@+id/tpmsbikeIMG"
        android:layout_width="486dp"
        android:layout_height="332dp"
        android:layout_marginTop="116dp"
        android:layout_marginEnd="152dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/tpmsgg" />


</androidx.constraintlayout.widget.ConstraintLayout>