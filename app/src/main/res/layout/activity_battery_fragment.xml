<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="1001dp"
    android:layout_height="418dp"
    android:background="@drawable/fragmentbg"
    tools:context=".BatteryFragment">

    <!-- Top Toggle Buttons -->
    <RadioGroup
        android:id="@+id/topToggleGroup"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="574dp"
        android:layout_marginTop="26dp">

        <RadioButton
            android:id="@+id/btnBattery"
            style="@style/BatteryFragToggleStyle"
            android:layout_width="160dp"
            android:layout_height="46dp"
            android:textSize="19dp"
            android:layout_marginEnd="2dp"
            android:text="Main Battery" />

        <RadioButton
            android:id="@+id/btnAuxillary"
            style="@style/BatteryFragToggleStyle"
            android:layout_width="155dp"
            android:layout_height="46dp"
            android:textSize="19dp"
            android:text="APU" />
    </RadioGroup>

    <!-- Top Container for Main Battery -->
    <LinearLayout
        android:id="@+id/topMainContainer"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="518dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/batterybar"
           />
        <!-- LEFT: BATTERY % -->
        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/topCardValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit"
                    android:text="00.00%"
                    android:textColor="#01FF58"
                    android:textSize="50sp" />

                <TextView
                    android:id="@+id/Batterytv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="battery level"
                    android:fontFamily="@font/kanit"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="#424242"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"/>

        <!-- RIGHT: RANGE -->
        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/RangeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- km"
                    android:fontFamily="@font/kanit"
                    android:textColor="#01FF58"
                    android:textSize="50sp" />

                <TextView
                    android:id="@+id/Rangetext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="range"
                    android:fontFamily="@font/kanit"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="990dp"
        android:layout_height="1dp"
        android:background="#424242"
        android:layout_marginTop="215dp"
        android:layout_marginHorizontal="6dp"/>

    <!-- Top Container for Aux Battery -->
    <LinearLayout
        android:id="@+id/topAuxContainer"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="518dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/apubatterybar"
            />
        <!-- LEFT: AUX BATTERY % -->
        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/topAuxValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:fontFamily="@font/kanit"
                    android:textColor="#01FF58"
                    android:textSize="50sp" />

                <TextView
                    android:id="@+id/topAuxBatteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="battery level"
                    android:fontFamily="@font/kanit"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="#424242"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"/>

        <!-- RIGHT: RANGE -->
        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/topAuxRangeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 km"
                    android:fontFamily="@font/kanit"
                    android:textColor="#01FF58"
                    android:textSize="50sp" />

                <TextView
                    android:id="@+id/topAuxRangeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="range"
                    android:fontFamily="@font/kanit"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Battery Details for Main Battery -->
    <ScrollView
        android:id="@+id/mainBatteryScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="230dp">

        <LinearLayout
