<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="1001dp"
    android:layout_height="418dp"
    android:background="@drawable/fragmentbg"
    tools:context=".supportFragment">

    <!-- Fixed Heading -->

    <!-- Scrollable Content -->

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="948dp"
        android:layout_height="122dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/supportheading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/imageView2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Row 1: Support Line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Emergency Support Helpline"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/kanitlite"
                    android:textSize="22sp"
                    android:paddingStart="15dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="898-898-4646"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="25sp"
                        android:paddingEnd="15dp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(Available 24x7)"
                        android:textColor="#CCCCCC"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Example Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="20dp"
                >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Website"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/kanitlite"
                    android:textSize="22sp"
                    android:paddingStart="15dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="rivotmotors.com"
                    android:textColor="#1C78BE"
                    android:fontFamily="@font/kanit"
                    android:paddingEnd="15dp"
                    android:textSize="23sp"  />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="23dp"
                >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Email Support"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/kanitlite"
                    android:textSize="23sp"
                    android:paddingStart="15dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="support@rivotmotors.com"
                    android:textColor="#1C78BE"
                    android:fontFamily="@font/kanit"
                    android:paddingEnd="15dp"
                    android:textSize="23sp"  />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="20dp"
                >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Service Center Locator"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/kanitlite"
                    android:textSize="22sp"
                    android:paddingStart="15dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="www.rivotmotors.com/servicecenter"
                    android:textColor="#1C78BE"
                    android:fontFamily="@font/kanit"
                    android:paddingEnd="15dp"
                    android:textSize="23sp"  />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="20dp"
                >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FAQ's"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/kanitlite"
                    android:textSize="22sp"
                    android:paddingStart="15dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Common questions and solutions"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="18sp"
                        android:paddingEnd="15dp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="www.rivotmotors.com/FAQ's"
                        android:textColor="#1C78BE"
                        android:fontFamily="@font/kanit"
                        android:paddingEnd="15dp"
                        android:textSize="23sp"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="20dp"
                >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Warranty information"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/kanitlite"
                    android:textSize="22sp"
                    android:paddingStart="15dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View your warranty details at"
                        android:textColor="#FFFFFF"
                        android:textAlignment="textEnd"
                        android:fontFamily="@font/kanitlite"
                        android:textSize="18sp"
                        android:paddingEnd="15dp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="www.rivotmotors.com/warranty"
                        android:textColor="#1C78BE"
                        android:fontFamily="@font/kanit"
                        android:paddingEnd="15dp"
                        android:textSize="23sp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
