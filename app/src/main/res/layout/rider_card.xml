<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="240dp"
    android:layout_marginEnd="16dp"
    android:elevation="4dp">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/ridercard1" />

    <!-- Overlay Content: Rider Name + Delete Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_marginBottom="5dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:gravity="center_horizontal">

        <!-- Rider Name a little above the bottom -->
        <TextView
            android:id="@+id/riderName"
            android:layout_width="165dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingBottom="5dp"
            android:text="Rider Name"
            android:textColor="#FFFFFF"
            android:textAlignment="center"
            android:fontFamily="@font/kanit"
            android:textSize="21sp"

            android:maxLines="1"
            android:ellipsize="end"
            />
        <TextView
            android:id="@+id/tvMaxSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Max speed : 70 Kmph"
            android:textColor="#A1A1A1"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="@font/kanit"
            />
        <TextView
            android:id="@+id/tvTorque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Torque level : Rush"
            android:textColor="#A1A1A1"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="@font/kanit"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="13dp">

            <!-- EDIT -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20dp">

                <ImageButton
                    android:id="@+id/editBtn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#00E5FF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/kanit"/>
            </LinearLayout>

            <!-- DELETE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/deleteBtn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#F10000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/kanit"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
