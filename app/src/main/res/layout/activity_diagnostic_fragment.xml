<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="1001dp"
    android:layout_height="418dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fragmentbg"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- OTA BRANCH -->


        <!-- BUTTON GRID -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="5"
            android:rowCount="6"
            android:useDefaultMargins="true">

            <!-- COLUMN 1 -->

            <Button
                android:id="@+id/handlelockbutton"
                style="@style/DiagButton"
                android:backgroundTint="#1C78BE"
                android:text="Handle Lock"/>
            <Button
                android:id="@+id/LEDON"
                style="@style/DiagButton"
                android:backgroundTint="#1C78BE"
                android:text="12V ON"/>

            <Button
                android:id="@+id/mcuotaupdatebtn"
                style="@style/DiagButton"
                android:backgroundTint="#D45333"
                android:text="TBD"/>

            <Button
                android:id="@+id/ToMain"
                style="@style/DiagButton"
                android:backgroundTint="#B40300"
                android:text="Switch to Main"/>
            <Button
                android:id="@+id/hightorque"
                style="@style/DiagButton"
                android:backgroundTint="#FF9BEB"
                android:textColor="@color/black"
                android:text="Reset line/phase"/>

            <Button
                android:id="@+id/handleUNlockbutton"
                style="@style/DiagButton"
                android:backgroundTint="#1C78BE"
                android:text="Handle Unlock"/>


            <!-- COLUMN 2 -->

            <Button
                android:id="@+id/LEDOFF"
                style="@style/DiagButton"
                android:backgroundTint="#1C78BE"
                android:text="12V OFF"/>

            <Button
                android:id="@+id/aospotaupdate"
                style="@style/DiagButton"
                android:backgroundTint="#D45333"
                android:text="TBD"/>


            <Button
                android:id="@+id/ToAPU"
                style="@style/DiagButton"
                android:backgroundTint="#B40300"
                android:text="Switch to APU"/>
            <Button
                android:id="@+id/Low"
                style="@style/DiagButton"
                android:backgroundTint="#FF9BEB"
                android:textColor="@color/black"
                android:text="Set line 15A"/>

            <Button
                android:id="@+id/bootbutton"
                style="@style/DiagButton"
                android:backgroundTint="#1C78BE"
                android:text="Seat Lock"/>
            <Button
                android:id="@+id/lockScreen"
                style="@style/DiagButton"
                android:backgroundTint="#1C78BE"
                android:text="TBD"/>

            <Button
                android:id="@+id/ResetAll"
                style="@style/DiagButton"
                android:backgroundTint="#FFFB06"
                android:textColor="@color/black"
                android:text="Reset ALL counters"/>


            <!-- COLUMN 3 -->



<!--            <Button-->
<!--                android:id="@+id/wifiOffBtn"-->
<!--                style="@style/DiagButton"-->
<!--                android:text="WiFi OFF"/>-->



            <Button
                android:id="@+id/resetRecoBtn"
                style="@style/DiagButton"
                android:backgroundTint="#FFFB06"
                android:textColor="@color/black"
                android:text="Reset reco"/>
            <Button
                android:id="@+id/Devicesettings"
                style="@style/DiagButton"
                android:backgroundTint="#7400A2"

                android:text="System settings"/>


            <!-- COLUMN 4 -->

            <Button
                android:id="@+id/resetAhvalues"
                style="@style/DiagButton"
                android:backgroundTint="#079500"
                android:text="Rest total IN-OUT AH"/>

<!--            <Button-->
<!--                android:id="@+id/wifiBtn"-->
<!--                style="@style/DiagButton"-->
<!--                android:text="WiFi ON"/>-->


            <Button
                android:id="@+id/in90"
                style="@style/DiagButton"
                android:backgroundTint="#079500"
                android:text="Set In AH 90"/>

            <Button
                android:id="@+id/resetChargerRegenBtn"
                style="@style/DiagButton"
                android:backgroundTint="#FFFB06"
                android:textColor="@color/black"
                android:text="Reset charger AH"/>


            <!-- COLUMN 5 -->
            <Button
                android:id="@+id/resetOdoBtn"
                style="@style/DiagButton"
                android:backgroundTint="#FFFB06"
                android:textColor="@color/black"
                android:text="Reset Odometer"/>

            <Button
                android:id="@+id/rebootbtn"
                style="@style/DiagButton"
                android:backgroundTint="#7400A2"
                android:text="Android restart"/>


            <Button
                android:id="@+id/out0"
                style="@style/DiagButton"
                android:backgroundTint="#079500"
                android:text="Set Out AH 0"/>

            <Button
                android:id="@+id/in60"
                style="@style/DiagButton"
                android:backgroundTint="#079500"
                android:text="Set In AH 60"/>

            <Button
                android:id="@+id/debug"
                style="@style/DiagButton"
                android:backgroundTint="#D9D9D9"
                android:textColor="@color/black"
                android:text="Pilot test"/>

            <Button
                android:id="@+id/btnmetadata"
                style="@style/DiagButton"
                android:backgroundTint="#D9D9D9"
                android:textColor="@color/black"
                android:text="Edit VIN"/>

            <Button
                android:id="@+id/shutdownbtn"
                style="@style/DiagButton"
                android:backgroundTint="#7400A2"
                android:text="Android shutdown"/>


        </GridLayout>

        <!-- REBOOT / SHUTDOWN -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <LinearLayout
                android:layout_width="500dp"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:background="@drawable/branch_card_bg">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Software Update Branch"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/kanitlite"/>

                <RelativeLayout
                    android:layout_width="170dp"
                    android:layout_height="40dp">

                    <Spinner
                        android:id="@+id/branchSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/spinner_blue_border"
                        android:spinnerMode="dropdown"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:src="@drawable/ic_spinner_arrow"/>

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginStart="40dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDecrease"
                    style="@style/DiagButton"
                    android:layout_width="60dp"
                    android:text="-"/>

                <TextView
                    android:id="@+id/tireDimensionDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:text="-"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"/>

                <Button
                    android:id="@+id/btnIncrease"
                    style="@style/DiagButton"
                    android:layout_width="60dp"
                    android:text="+"/>
            </LinearLayout>

            <TextView
                android:id="@+id/ipTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Board ID"
                android:layout_marginStart="40dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"/>

        </LinearLayout>





    </LinearLayout>

</ScrollView>