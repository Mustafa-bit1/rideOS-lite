<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="1001dp"
    android:layout_height="418dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/fragmentbg">

    <Button
        android:id="@+id/bootbutton"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="180dp"
        android:backgroundTint="#0878C1"
        android:text="Open Boot"
        android:textSize="15dp"
        android:foreground="@drawable/btn_click_effect"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/resetAhvalues"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginStart="84dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="BAttAh"
        android:textSize="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/Low"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="784dp"
        android:layout_marginTop="248dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="Low"
        android:textSize="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/hightorque"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="784dp"
        android:layout_marginTop="310dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="Reset parameters"
        android:textSize="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/Devicesettings"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="264dp"
        android:layout_marginTop="316dp"
        android:backgroundTint="#0878C1"
        android:text="System"
        android:textSize="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/handlelockbutton"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="44dp"
        android:backgroundTint="#0878C1"
        android:text="Handle Lock"
        android:textSize="15dp"
        android:foreground="@drawable/btn_click_effect"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/handleUNlockbutton"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="112dp"
        android:backgroundTint="#0878C1"
        android:text="Handle Unlock"
        android:textSize="15dp"
        android:foreground="@drawable/btn_click_effect"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/lockScreen"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="316dp"
        android:backgroundTint="#0878C1"
        android:text="Lock Scooter"
        android:foreground="@drawable/btn_click_effect"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/ToAPU"
        android:layout_width="190dp"
        android:layout_height="50dp"
        android:layout_marginStart="240dp"
        android:layout_marginTop="250dp"
        android:backgroundTint="#0878C1"
        android:text="Switch to APU"
        android:foreground="@drawable/btn_click_effect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/ToMain"
        android:layout_width="190dp"
        android:layout_height="50dp"
        android:layout_marginStart="240dp"
        android:layout_marginTop="180dp"
        android:backgroundTint="#0878C1"
        android:text="Switch to Main"
        android:foreground="@drawable/btn_click_effect"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/LEDON"
        android:layout_width="190dp"
        android:layout_height="50dp"
        android:layout_marginStart="512dp"
        android:layout_marginTop="180dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="LED ON"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/LEDOFF"
        android:layout_width="190dp"
        android:layout_height="50dp"
        android:layout_marginStart="512dp"
        android:layout_marginTop="244dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="LED OFF"
        android:textColor="@color/white"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/in60"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginStart="328dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="in60"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/in90"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginStart="208dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="in90"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/out0"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginStart="448dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="out0"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/wifiBtn"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="532dp"
        android:layout_marginTop="112dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="Turn WiFi ON"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/wifiOffBtn"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="532dp"
        android:layout_marginTop="44dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="Turn WiFi OFF"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/debug"
        android:layout_width="170dp"
        android:layout_height="51dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="250dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="Open Debug Mode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/btnmetadata"
        android:layout_width="170dp"
        android:layout_height="51dp"
        android:layout_marginStart="772dp"
        android:layout_marginTop="180dp"
        android:backgroundTint="#0878C1"
        android:foreground="@drawable/btn_click_effect"
        android:text="Edit EV data"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/mcuotaupdatebtn"
        android:layout_width="276dp"
        android:layout_height="42dp"
        android:layout_marginStart="208dp"
        android:layout_marginTop="58dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/mcuupdatebtn"
        android:foreground="@drawable/btn_click_effect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/aospotaupdate"
        android:layout_width="276dp"
        android:layout_height="42dp"
        android:layout_marginStart="208dp"
        android:layout_marginTop="115dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/aospupdatebtn"
        android:foreground="@drawable/btn_click_effect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/rebootbtn"
        android:layout_width="256dp"
        android:layout_height="48dp"
        android:layout_marginStart="712dp"
        android:layout_marginTop="44dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:foreground="@drawable/btn_click_effect"
        android:padding="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/rebootbtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/shutdownbtn"
        android:layout_width="276dp"
        android:layout_height="48dp"
        android:layout_marginStart="712dp"
        android:layout_marginTop="112dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:foreground="@drawable/btn_click_effect"
        android:padding="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/shutdownbtn"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="80dp"
        android:layout_marginTop="300dp"
        android:layout_marginEnd="240dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnDecrease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#0878C1"
            android:fontFamily="@font/opti"
            android:text="-"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/tireDimensionDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:padding="14dp"
            android:text="-"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnIncrease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#0878C1"
            android:fontFamily="@font/opti"
            android:text="+"
            android:textSize="20dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rideOS_version"
        android:layout_width="400dp"
        android:layout_height="50dp"
        android:layout_marginBottom="1dp"
        android:fontFamily="@font/kanit"
        android:text=""
        android:textAlignment="textEnd"
        android:textColor="@color/white"
        android:textSize="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/ipTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="15dp"
        android:text="IP Address: --"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>